# Bash completion for the palang command. Installed as
# /usr/share/bash-completion/completions/palang; bash loads it the first
# time you press Tab after "palang".
#
# In the Palang terminal (PALANG_TERMINAL=1), it completes the subcommands,
# setting names after get/set/reset, and values after "set NAME". The words
# come from the running Palang itself ("palang __complete …"), so this
# script never needs updating. Everywhere else, and wherever no word fits,
# bash completes file names as usual ("-o default" below).

_palang ()
{
    local current="${COMP_WORDS[COMP_CWORD]}"
    local words=""

    COMPREPLY=()
    if [[ "$PALANG_TERMINAL" != "1" ]]; then
        return
    fi

    if (( COMP_CWORD == 1 )); then
        words="$(palang __complete subcommands 2>/dev/null)"
    elif (( COMP_CWORD == 2 )); then
        case "${COMP_WORDS[1]}" in
            get|set|reset) words="$(palang __complete names 2>/dev/null)" ;;
        esac
    elif (( COMP_CWORD == 3 )) && [[ "${COMP_WORDS[1]}" == "set" ]]; then
        words="$(palang __complete values "${COMP_WORDS[2]}" 2>/dev/null)"
    fi

    COMPREPLY=( $(compgen -W "$words" -- "$current") )
}

complete -o default -F _palang palang
