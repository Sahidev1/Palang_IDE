<?xml version="1.0" encoding="UTF-8"?>
<!-- Layout of the main window. Behaviour lives in src/app/palang-window.c. -->
<interface>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label">_New</attribute>
        <attribute name="action">win.new</attribute>
      </item>
      <item>
        <attribute name="label">_Open…</attribute>
        <attribute name="action">win.open</attribute>
      </item>
      <item>
        <attribute name="label">Open _Folder…</attribute>
        <attribute name="action">win.open-folder</attribute>
      </item>
      <item>
        <attribute name="label">Open File in Folder…</attribute>
        <attribute name="action">win.quick-open</attribute>
      </item>
      <item>
        <attribute name="label">_Command Palette…</attribute>
        <attribute name="action">win.command-palette</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label">_Save</attribute>
        <attribute name="action">win.save</attribute>
      </item>
      <item>
        <attribute name="label">Save _As…</attribute>
        <attribute name="action">win.save-as</attribute>
      </item>
      <item>
        <attribute name="label">Save A_ll</attribute>
        <attribute name="action">win.save-all</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label">_Find…</attribute>
        <attribute name="action">win.find</attribute>
      </item>
      <item>
        <attribute name="label">Find and _Replace…</attribute>
        <attribute name="action">win.replace</attribute>
      </item>
      <item>
        <attribute name="label">_Go to Line…</attribute>
        <attribute name="action">win.go-to-line</attribute>
      </item>
      <item>
        <attribute name="label">Search in _Folder…</attribute>
        <attribute name="action">win.search-project</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label">_Close Tab</attribute>
        <attribute name="action">win.close-tab</attribute>
      </item>
      <item>
        <attribute name="label">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label">_Quit</attribute>
        <attribute name="action">app.quit</attribute>
      </item>
    </section>
  </menu>

  <template class="PalangWindow" parent="AdwApplicationWindow">
    <property name="title">Palang</property>
    <property name="default-width">1000</property>
    <property name="default-height">700</property>
    <property name="content">
      <!-- Sidebar (folder tree) on the left, tabs on the right. Each side
           has its own header bar, the usual libadwaita pattern. -->
      <object class="AdwOverlaySplitView" id="split_view">
        <property name="show-sidebar">false</property>
        <property name="min-sidebar-width">200</property>
        <property name="max-sidebar-width">320</property>
        <property name="sidebar">
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <property name="show-end-title-buttons">false</property>
                <property name="title-widget">
                  <object class="AdwWindowTitle" id="sidebar_title"/>
                </property>
                <child type="end">
                  <object class="GtkToggleButton">
                    <property name="icon-name">view-reveal-symbolic</property>
                    <property name="tooltip-text">Show Hidden Files</property>
                    <property name="active" bind-source="file_tree" bind-property="show-hidden" bind-flags="sync-create|bidirectional"/>
                  </object>
                </child>
              </object>
            </child>
            <property name="content">
              <object class="PalangFileTree" id="file_tree">
                <signal name="file-activated" handler="on_file_activated"/>
              </object>
            </property>
          </object>
        </property>
        <property name="content">
          <!-- AdwToolbarView: header bar and tab bar on top, content below. -->
          <object class="AdwToolbarView">
            <child type="top">
              <object class="AdwHeaderBar">
                <child type="start">
                  <object class="GtkToggleButton">
                    <property name="icon-name">sidebar-show-symbolic</property>
                    <property name="tooltip-text">Show Folder (F9)</property>
                    <property name="active" bind-source="split_view" bind-property="show-sidebar" bind-flags="sync-create|bidirectional"/>
                  </object>
                </child>
                <child type="start">
                  <object class="GtkButton">
                    <property name="label">_Open</property>
                    <property name="use-underline">true</property>
                    <property name="action-name">win.open</property>
                    <property name="tooltip-text">Open a File (Ctrl+O)</property>
                  </object>
                </child>
                <child type="start">
                  <object class="GtkButton">
                    <property name="icon-name">tab-new-symbolic</property>
                    <property name="action-name">win.new</property>
                    <property name="tooltip-text">New File (Ctrl+N)</property>
                  </object>
                </child>
                <property name="title-widget">
                  <object class="AdwWindowTitle" id="window_title">
                    <property name="title">Palang</property>
                  </object>
                </property>
                <child type="end">
                  <object class="GtkMenuButton">
                    <property name="icon-name">open-menu-symbolic</property>
                    <property name="menu-model">primary_menu</property>
                    <property name="primary">true</property>
                    <property name="tooltip-text">Main Menu</property>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkToggleButton">
                    <property name="icon-name">utilities-terminal-symbolic</property>
                    <property name="tooltip-text">Show Panel: Terminal, Search (Ctrl+J)</property>
                    <property name="active" bind-source="panel" bind-property="visible" bind-flags="sync-create|bidirectional"/>
                  </object>
                </child>
              </object>
            </child>
            <child type="top">
              <object class="AdwTabBar" id="tab_bar">
                <property name="view">tab_view</property>
                <property name="autohide">false</property>
              </object>
            </child>
            <property name="content">
              <!-- Tabs on top, the bottom panel (terminal, search) below.
                   The user drags the divider between them. When the window
                   grows, the tabs get the extra space and the panel keeps
                   its height (resize-end-child = false). -->
              <object class="GtkPaned" id="paned">
                <property name="orientation">vertical</property>
                <property name="resize-end-child">false</property>
                <property name="shrink-end-child">false</property>
                <property name="start-child">
                  <!-- Shows error messages ("toasts") on top of the content. -->
                  <object class="AdwToastOverlay" id="toast_overlay">
                    <property name="child">
                      <!-- "empty" when no tabs are open, "tabs" otherwise. -->
                      <object class="GtkStack" id="stack">
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">empty</property>
                            <property name="child">
                              <object class="AdwStatusPage">
                                <property name="icon-name">text-editor-symbolic</property>
                                <property name="title">No Open Files</property>
                                <property name="description">Press Ctrl+O to open a file, Ctrl+Shift+O to open a folder, or Ctrl+N to start a new file.</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">tabs</property>
                            <property name="child">
                              <object class="AdwTabView" id="tab_view"/>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="end-child">
                  <object class="PalangPanel" id="panel">
                    <property name="visible">false</property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
