<?xml version="1.0" encoding="UTF-8"?>
<!-- Layout of the main window. Behaviour lives in src/app/palang-window.c. -->
<interface>
  <template class="PalangWindow" parent="AdwApplicationWindow">
    <property name="title">Palang</property>
    <property name="default-width">1000</property>
    <property name="default-height">700</property>
    <property name="content">
      <!-- AdwToolbarView: a header bar on top, the main content below. -->
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar"/>
        </child>
        <property name="content">
          <object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <property name="child">
              <object class="GtkSourceView" id="source_view">
                <property name="monospace">true</property>
                <property name="show-line-numbers">true</property>
                <property name="highlight-current-line">true</property>
                <property name="auto-indent">true</property>
                <property name="indent-width">2</property>
                <property name="insert-spaces-instead-of-tabs">true</property>
                <property name="tab-width">8</property>
                <property name="top-margin">6</property>
                <property name="bottom-margin">6</property>
                <property name="left-margin">6</property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
